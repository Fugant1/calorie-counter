{
  "version": "1.0.0",
  "description": "Per-node LLM configuration for the Calorie-Counter AI agent graph. MealParser uses a very small, low-latency LLM dedicated strictly to converting noisy natural-language meal write-ups (including typos like 'ovio' or 'ovoos') into structured JSON with foods, quantities, and household-measure flags.",
  "nodes": {
    "IntentRouter": {
      "node_id": "IntentRouter",
      "hierarchy_role": "Planner",
      "model_tier": "Tier1FastNano",
      "provider": "openai_compatible_or_local",
      "model_id": "qwen2.5-1.5b-instruct",
      "temperature": 0.0,
      "max_output_tokens": 128,
      "response_format": "json_object",
      "prompt_cost_micros_per_1k": 100,
      "completion_cost_micros_per_1k": 300,
      "purpose": "Classifies user intent (RegisterMeal, AskNutrition, RegisterMealAndAskNutrition) and language (PT/EN)."
    },
    "AudioTranscriber": {
      "node_id": "AudioTranscriber",
      "hierarchy_role": "ToolCaller",
      "model_tier": "Tier0Deterministic",
      "provider": "local_whisper_candle",
      "model_id": "whisper-large-v3-turbo-q5",
      "temperature": 0.0,
      "max_output_tokens": 0,
      "response_format": "text",
      "prompt_cost_micros_per_1k": 0,
      "completion_cost_micros_per_1k": 0,
      "purpose": "Local Silero VAD + Whisper speech-to-text transcription before MealParser."
    },
    "MealParser": {
      "node_id": "MealParser",
      "hierarchy_role": "Planner",
      "model_tier": "Tier1FastNano",
      "provider": "tiny_llm_json_extractor",
      "model_id": "qwen2.5-1.5b-instruct-json",
      "temperature": 0.0,
      "max_output_tokens": 256,
      "response_format": "json_object",
      "prompt_cost_micros_per_1k": 80,
      "completion_cost_micros_per_1k": 240,
      "purpose": "Very small LLM that converts free-form meal write-ups and user typos (e.g., 'ovio', 'ovoos', 'paes de forna') into strict JSON containing normalized food names, quantities, units, and whether the measure is a household unit requiring ground-truth inference."
    },
    "CacheLookup": {
      "node_id": "CacheLookup",
      "hierarchy_role": "ToolCaller",
      "model_tier": "Tier0Deterministic",
      "provider": "redis_pgvector_cache",
      "model_id": "tier0-redis-l1-l2-cache",
      "temperature": 0.0,
      "max_output_tokens": 0,
      "response_format": "json_object",
      "prompt_cost_micros_per_1k": 0,
      "completion_cost_micros_per_1k": 0,
      "purpose": "Checks Redis L1 exact key/barcode and L2 semantic vector cache for macros and ground-truth household measure gram weights."
    },
    "WebSearchAndRAG": {
      "node_id": "WebSearchAndRAG",
      "hierarchy_role": "ToolCaller",
      "model_tier": "Tier1FastNano",
      "provider": "google_gemini_or_openai",
      "model_id": "gemini-2.5-flash-lite",
      "temperature": 0.0,
      "max_output_tokens": 512,
      "response_format": "json_object",
      "prompt_cost_micros_per_1k": 150,
      "completion_cost_micros_per_1k": 600,
      "purpose": "Executes web search fan-out (TACO, IBGE Tabela de Medidas Caseiras, USDA FoodData Central, SearXNG) to extract ground-truth per-100g macros and ground-truth gram weights for household measures."
    },
    "NutritionVerifier": {
      "node_id": "NutritionVerifier",
      "hierarchy_role": "Planner",
      "model_tier": "Tier2Reasoning",
      "provider": "google_gemini_or_openai",
      "model_id": "gemini-2.5-pro",
      "temperature": 0.1,
      "max_output_tokens": 512,
      "response_format": "json_object",
      "prompt_cost_micros_per_1k": 2500,
      "completion_cost_micros_per_1k": 10000,
      "purpose": "Verifies Atwater macro consistency (4P + 4C + 9F) and ground-truth household measure plausibility."
    },
    "MacroCalculator": {
      "node_id": "MacroCalculator",
      "hierarchy_role": "Executioner",
      "model_tier": "Tier0Deterministic",
      "provider": "deterministic_rust",
      "model_id": "tier0-deterministic-macro-scaler",
      "temperature": 0.0,
      "max_output_tokens": 0,
      "response_format": "json_object",
      "prompt_cost_micros_per_1k": 0,
      "completion_cost_micros_per_1k": 0,
      "purpose": "Deterministically scales per-100g macros by the ground-truth gram weight of each food item."
    },
    "CoachingAgent": {
      "node_id": "CoachingAgent",
      "hierarchy_role": "ToolCaller",
      "model_tier": "Tier2Reasoning",
      "provider": "google_gemini_or_openai",
      "model_id": "gemini-2.5-pro",
      "temperature": 0.3,
      "max_output_tokens": 900,
      "response_format": "text",
      "prompt_cost_micros_per_1k": 2500,
      "completion_cost_micros_per_1k": 10000,
      "purpose": "Synthesizes personalized diet coaching and calorie-exchange advice grounded in the user's PDF/TXT nutrition plan and chat memory."
    },
    "MemoryUpdater": {
      "node_id": "MemoryUpdater",
      "hierarchy_role": "Executioner",
      "model_tier": "Tier1FastNano",
      "provider": "google_gemini_or_openai",
      "model_id": "gemini-2.5-flash-lite",
      "temperature": 0.0,
      "max_output_tokens": 256,
      "response_format": "json_object",
      "prompt_cost_micros_per_1k": 150,
      "completion_cost_micros_per_1k": 600,
      "purpose": "Commits meal registrations idempotently to the ledger and compacts Working/Episodic/Semantic memory."
    },
    "ResponseSynthesizer": {
      "node_id": "ResponseSynthesizer",
      "hierarchy_role": "Executioner",
      "model_tier": "Tier1FastNano",
      "provider": "google_gemini_or_openai",
      "model_id": "gemini-2.5-flash-lite",
      "temperature": 0.2,
      "max_output_tokens": 512,
      "response_format": "text",
      "prompt_cost_micros_per_1k": 150,
      "completion_cost_micros_per_1k": 600,
      "purpose": "Formats the final user-facing meal registration and nutrition response."
    },
    "Terminal": {
      "node_id": "Terminal",
      "hierarchy_role": "Executioner",
      "model_tier": "Tier0Deterministic",
      "provider": "deterministic_rust",
      "model_id": "tier0-terminal-sink",
      "temperature": 0.0,
      "max_output_tokens": 0,
      "response_format": "text",
      "prompt_cost_micros_per_1k": 0,
      "completion_cost_micros_per_1k": 0,
      "purpose": "Terminal graph sink."
    }
  }
}
